{
  "name": "Universal API Orchestrator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8080, 8765],
  "portsAttributes": {"8080": {"label": "Gateway (mantener privado)"}, "8765": {"label": "OAuth loopback temporal"}},
  "postCreateCommand": "pip install -e '.[auth,dev]' && python scripts/bootstrap.py",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}}
}
