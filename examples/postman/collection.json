{
  "info": {
    "name": "Universal API Orchestrator v0.2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usa credenciales locales. Los envíos requieren confirmed=true y aprobación separada."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "gatewayKey",
      "value": ""
    },
    {
      "key": "approvalKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "gmail-search",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{gatewayKey}}"
          },
          {
            "key": "X-Approval-Key",
            "value": "{{approvalKey}}",
            "disabled": true
          }
        ],
        "url": "{{baseUrl}}/v1/execute",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"system\": \"gmail\",\n  \"operation\": \"list_messages\",\n  \"params\": {\n    \"q\": \"is:unread newer_than:7d\",\n    \"maxResults\": 10\n  }\n}"
        }
      }
    },
