APP_ENV=development
SYSTEMS_CONFIG=config/systems.yaml
GATEWAY_API_KEY=
APPROVAL_API_KEY=
STATE_KEY=
STATE_DB=data/state.sqlite3
ALLOW_WRITES=false
ALLOW_PRIVATE_NETWORKS=false
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENCY=8
# Pool HTTP compartido del proceso.
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# Control de carga local por clave de llamada; 0 desactiva el limite.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
# Valores por defecto de uao prune-events y uao prune-requests; la purga es manual.
EVENTS_RETENTION_DAYS=30
REQUESTS_RETENTION_DAYS=90
# Cada proveedor está deshabilitado hasta ejecutar uao enable NOMBRE.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
DISCORD_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDGRID_API_KEY=
RESEND_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
AI_MODE=off
AI_ALLOW_SENSITIVE_DATA=false
AI_MAX_INPUT_CHARS=24000
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_MODEL=
AI_ALLOWED_HOST=api.openai.com
